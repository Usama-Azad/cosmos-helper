{
  "name": "cosmos-helper",
  "version": "0.1.0",
  "description": "Helper functions for Azure Cosmos DB",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack": "npm pack 2>&1",
    "prepare": "npm run build",
    "clean": "rimraf --glob dist dist-* *.tgz *.log package-lock.json",
    "bundle": "npm run clean && npm install && npm run build && npm run pack",
    "test": "jest"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cosmosdb",
    "cosmosdb-helper",
    "query-builder",
    "typescript",
    "pagination",
    "safe-queries",
    "partition-key"
  ],
  "author": "Usama Azad",
  "repository": "github:Usama-Azad/cosmos-helper",
  "homepage": "https://github.com/Usama-Azad/cosmos-helper/tree/main/README.md",
  "bugs": {
    "url": "https://github.com/Usama-Azad/cosmos-helper/issues"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "~5.8.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
